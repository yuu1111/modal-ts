{
  "name": "modal-ts",
  "version": "1.0.0",
  "description": "Unofficial Modal SDK for JavaScript/TypeScript",
  "license": "Apache-2.0",
  "homepage": "https://github.com/yuu1111/modal-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuu1111/modal-ts.git"
  },
  "bugs": "https://github.com/yuu1111/modal-ts/issues",
  "author": "yuu1111",
  "contributors": [
    "Modal Labs (https://modal.com)"
  ],
  "keywords": [
    "modal",
    "serverless",
    "sdk",
    "grpc",
    "sandbox",
    "gpu",
    "cloud"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "main": "dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write --unsafe .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:parity": "bun scripts/audit-python-parity.ts",
    "prepublishOnly": "bun run build",
    "version": "bun run typecheck",
    "docs": "bun run docs:api",
    "docs:api": "typedoc --entryPoints src/index.ts --out .typedoc --readme docs/en/README.md",
    "proto": "bun scripts/gen-proto.ts"
  },
  "dependencies": {
    "cbor-x": "^1.6.4",
    "long": "^5.3.2",
    "nice-grpc": "^2.1.16",
    "protobufjs": "^8.6.5",
    "smol-toml": "^1.7.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.3.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@yuu1111/biome-config": "^1.0.4",
    "@yuu1111/tsconfig": "^1.0.3",
    "esbuild": "^0.28.1",
    "grpc-tools": "^1.13.1",
    "http-server": "^14.1.1",
    "jsonwebtoken": "^9.0.3",
    "p-queue": "^9.3.0",
    "ts-proto": "^2.11.10",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
